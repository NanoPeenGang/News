# --- Database ---
DATABASE_URL="postgresql://marketmind:marketmind@localhost:5432/marketmind"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-me-in-production-0f8a2c"
# Optional Google OAuth (leave blank to disable the button's backend)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Market data ---
# mock | polygon | finnhub
MARKET_DATA_PROVIDER="mock"
POLYGON_API_KEY=""
FINNHUB_API_KEY=""

# --- AI ---
# Leave blank to use the built-in deterministic analysis engine (no external calls)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Scanner engine ---
SCAN_INTERVAL_SECONDS="60"
PRICE_TICK_SECONDS="2"
WS_PORT="3001"
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# --- Stripe (stubbed) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Demo convenience: return password-reset tokens in the API response (no email sender wired). Set to 0 in production.
EXPOSE_RESET_TOKENS="1"

# --- Brokerage connections ---
# AES-256-GCM key for provider tokens at rest (64 hex chars). Falls back to a
# key derived from NEXTAUTH_SECRET in dev. Generate: openssl rand -hex 32
BROKERAGE_ENCRYPTION_KEY=""
# SnapTrade (Robinhood data + trading) — https://snaptrade.com
SNAPTRADE_CLIENT_ID=""
SNAPTRADE_CONSUMER_KEY=""
# Plaid Investments (read-only fallback) — https://plaid.com
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
# Master switch for live order placement (portfolio sync works regardless)
ENABLE_LIVE_TRADING="false"
# Worker portfolio sync cadence (seconds)
BROKERAGE_SYNC_SECONDS="300"
