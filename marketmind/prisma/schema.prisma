generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FREE
  PREMIUM
  ADMIN
}

enum SignalDirection {
  LONG
  SHORT
}

enum SignalStatus {
  WAITING
  ENTRY_ACTIVE
  TARGET1_HIT
  TARGET2_HIT
  STOPPED_OUT
  EXPIRED
}

enum SetupType {
  MOMENTUM_BREAKOUT
  VWAP_RECLAIM
  OVERSOLD_BOUNCE
  GAP_AND_GO
  UNUSUAL_VOLUME
  EMA_CROSSOVER
}

enum LessonLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TradeSide {
  BUY
  SELL
}

// ---------- Auth ----------

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           Role      @default(FREE)
  createdAt      DateTime  @default(now())
  resetToken     String?
  resetTokenExp  DateTime?

  accounts        Account[]
  sessions        Session[]
  watchlists      Watchlist[]
  journalEntries  JournalEntry[]
  lessonProgress  LessonProgress[]
  paperAccount    PaperAccount?
  alertPrefs      AlertPreference?
  alerts          Alert[]
  coachingReports CoachingReport[]
  chatMessages    ChatMessage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Watchlists ----------

model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  symbol      String
  addedAt     DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
}

// ---------- Signals ----------

model Signal {
  id          String          @id @default(cuid())
  symbol      String
  setupType   SetupType
  direction   SignalDirection
  status      SignalStatus    @default(WAITING)
  confidence  Int // 0-100 "setup conditions score", probabilistic language only
  entryLow    Float
  entryHigh   Float
  stopLoss    Float
  target1     Float // 1:2 R/R
  target2     Float // 1:3 R/R
  priceAtScan Float
  atr         Float
  rsi         Float?
  relVolume   Float?
  gapPercent  Float?
  vwap        Float?
  technicals  Json? // full indicator snapshot at scan time
  thesis      String?  @db.Text // AI-generated trade thesis
  risks       String?  @db.Text
  proNotes    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime?

  events   SignalEvent[]
  journals JournalEntry[]

  @@index([symbol])
  @@index([status])
  @@index([createdAt])
}

model SignalEvent {
  id        String       @id @default(cuid())
  signalId  String
  fromState SignalStatus?
  toState   SignalStatus
  price     Float?
  note      String?
  createdAt DateTime     @default(now())
  signal    Signal       @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([signalId])
}

// ---------- Alerts ----------

model AlertPreference {
  id             String  @id @default(cuid())
  userId         String  @unique
  entryZone      Boolean @default(true)
  stopThreatened Boolean @default(true)
  targetHit      Boolean @default(true)
  browserPush    Boolean @default(false)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  signalId  String?
  symbol    String
  kind      String // ENTRY_ZONE | STOP_THREAT | TARGET_HIT | INFO
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ---------- Education ----------

model Lesson {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  level       LessonLevel
  order       Int
  summary     String
  content     String      @db.Text // markdown
  minutes     Int         @default(8)
  premiumOnly Boolean     @default(false)
  progress    LessonProgress[]
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?
  startedAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ---------- Journal & Coaching ----------

model JournalEntry {
  id         String    @id @default(cuid())
  userId     String
  signalId   String?
  symbol     String
  side       TradeSide
  entryPrice Float
  exitPrice  Float?
  quantity   Float
  stopLoss   Float?
  target     Float?
  pnl        Float?
  rMultiple  Float?
  notes      String?   @db.Text
  mistakes   String? // comma-separated tags e.g. "moved-stop,oversized"
  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal     Signal?   @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model CoachingReport {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text // markdown
  stats     Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Paper trading ----------

model PaperAccount {
  id            String          @id @default(cuid())
  userId        String          @unique
  startBalance  Float           @default(100000)
  cash          Float           @default(100000)
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions     PaperPosition[]
  trades        PaperTrade[]
}

model PaperPosition {
  id        String       @id @default(cuid())
  accountId String
  symbol    String
  quantity  Float
  avgPrice  Float
  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol])
}

model PaperTrade {
  id        String       @id @default(cuid())
  accountId String
  symbol    String
  side      TradeSide
  quantity  Float
  price     Float
  pnl       Float? // realized P&L for closing trades
  signalId  String?
  createdAt DateTime     @default(now())
  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// ---------- AI ----------

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // user | assistant
  content   String   @db.Text
  context   String? // ticker / signal id the question was about
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AiAuditLog {
  id        String   @id @default(cuid())
  kind      String // thesis | chat | briefing | coaching | lesson
  userId    String?
  model     String
  prompt    String   @db.Text
  output    String   @db.Text
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

model DailyBriefing {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD
  session   String // premarket | postmarket
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@unique([date, session])
}
